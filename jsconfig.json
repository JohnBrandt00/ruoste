{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "types": [
      "node",
      "vscode"
    ],
    "baseUrl": ".",
    "paths": {
      "string_decoder": ["./node_modules/@types/node/string_decoder.d.ts"]
    }
  },
  "include": [
    "src/**/*.js",
    "test/**/*.js"
  ]
}