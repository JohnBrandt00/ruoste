{
  "name": "ruoste",
  "displayName": "RUOSTE",
  "description": "Swiss industrial brutalism for VS Code \u2014 three themes, Phosphor file and product icons, Geist Mono with a one-click installer, a GitHub Actions panel and a full Spotify player. Tuned for C# and TypeScript.",
  "version": "2.3.2",
  "publisher": "gapashu",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "theme",
    "dark",
    "light",
    "high contrast",
    "brutalism",
    "swiss",
    "industrial",
    "phosphor",
    "product icon theme",
    "icons",
    "csharp",
    "dotnet",
    "typescript",
    "geist mono",
    "monospace",
    "minimal",
    "warm",
    "sepia",
    "rust",
    "finnish",
    "github actions",
    "workflow",
    "ci",
    "continuous integration",
    "spotify",
    "music",
    "player",
    "now playing",
    "media control"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#14120E",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "RUOSTE",
        "uiTheme": "vs-dark",
        "path": "./themes/ruoste-color-theme.json"
      },
      {
        "label": "RUOSTE Paperi",
        "uiTheme": "vs",
        "path": "./themes/ruoste-paperi-color-theme.json"
      },
      {
        "label": "RUOSTE Kontrasti",
        "uiTheme": "hc-black",
        "path": "./themes/ruoste-kontrasti-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "ruoste-icons",
        "label": "RUOSTE (Phosphor Duotone)",
        "path": "./themes/ruoste-icon-theme.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "ruoste-product-icons",
        "label": "RUOSTE (Phosphor)",
        "path": "./themes/ruoste-product-icon-theme.json"
      }
    ],
    "configurationDefaults": {
      "editor.fontFamily": "'Geist Mono', 'GeistMono Nerd Font', 'JetBrains Mono', 'IBM Plex Mono', 'SFMono-Regular', Menlo, Consolas, monospace",
      "editor.fontLigatures": true,
      "editor.codeLensFontFamily": "'Geist Mono', 'JetBrains Mono', monospace",
      "editor.inlayHints.fontFamily": "'Geist Mono', 'JetBrains Mono', monospace",
      "terminal.integrated.fontFamily": "'Geist Mono', 'GeistMono Nerd Font', 'JetBrains Mono', Menlo, Consolas, monospace",
      "debug.console.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, Consolas, monospace",
      "notebook.output.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, Consolas, monospace",
      "chat.editor.fontFamily": "'Geist Mono', 'JetBrains Mono', Menlo, Consolas, monospace",
      "scm.inputFontFamily": "editor"
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ruoste",
          "title": "RUOSTE",
          "icon": "media/activity-bar.svg"
        },
        {
          "id": "ruoste-spotify",
          "title": "RUOSTE Spotify",
          "icon": "media/activity-bar-spotify.svg"
        }
      ]
    },
    "views": {
      "ruoste": [
        {
          "id": "ruoste.actions",
          "name": "GitHub Actions",
          "contextualTitle": "RUOSTE \u2014 GitHub Actions"
        }
      ],
      "ruoste-spotify": [
        {
          "id": "ruoste.spotify.nowPlaying",
          "name": "Now Playing",
          "type": "webview",
          "contextualTitle": "RUOSTE \u2014 Spotify"
        },
        {
          "id": "ruoste.spotify.library",
          "name": "Library",
          "contextualTitle": "RUOSTE \u2014 Spotify Library"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ruoste.actions",
        "contents": "Open a folder whose git remote points at GitHub to watch its workflow runs here.\n[Open Folder](command:vscode.openFolder)",
        "when": "!ruoste.actions.hasRepo"
      },
      {
        "view": "ruoste.actions",
        "contents": "Sign in to GitHub to watch workflow runs for this repository.\n[Sign in to GitHub](command:ruoste.actions.signIn)\nRUOSTE uses VS Code's built-in GitHub account \u2014 no personal access token needed.",
        "when": "ruoste.actions.hasRepo && !ruoste.actions.signedIn"
      },
      {
        "view": "ruoste.spotify.library",
        "contents": "Connect Spotify to browse your playlists, queue and devices.\n[Connect Spotify](command:ruoste.spotify.signIn)",
        "when": "!ruoste.spotify.signedIn"
      }
    ],
    "commands": [
      {
        "command": "ruoste.installFont",
        "title": "Install Geist Mono",
        "category": "RUOSTE"
      },
      {
        "command": "ruoste.useFontSetting",
        "title": "Use Geist Mono as the editor font",
        "category": "RUOSTE"
      },
      {
        "command": "ruoste.actions.refresh",
        "title": "Refresh",
        "category": "RUOSTE",
        "icon": "$(refresh)"
      },
      {
        "command": "ruoste.actions.signIn",
        "title": "Sign in to GitHub",
        "category": "RUOSTE"
      },
      {
        "command": "ruoste.actions.focus",
        "title": "Show GitHub Actions",
        "category": "RUOSTE"
      },
      {
        "command": "ruoste.actions.open",
        "title": "Open on GitHub",
        "category": "RUOSTE",
        "icon": "$(link-external)"
      },
      {
        "command": "ruoste.actions.copyUrl",
        "title": "Copy Run URL",
        "category": "RUOSTE"
      },
      {
        "command": "ruoste.actions.rerun",
        "title": "Re-run Workflow",
        "category": "RUOSTE",
        "icon": "$(debug-restart)"
      },
      {
        "command": "ruoste.actions.cancel",
        "title": "Cancel Run",
        "category": "RUOSTE",
        "icon": "$(stop-circle)"
      },
      {
        "command": "ruoste.spotify.signIn",
        "title": "Connect Spotify",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.signOut",
        "title": "Disconnect Spotify",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.setClientId",
        "title": "Set Spotify Client ID",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.toggle",
        "title": "Play / Pause",
        "category": "RUOSTE Spotify",
        "icon": "$(play)"
      },
      {
        "command": "ruoste.spotify.next",
        "title": "Next Track",
        "category": "RUOSTE Spotify",
        "icon": "$(chevron-right)"
      },
      {
        "command": "ruoste.spotify.previous",
        "title": "Previous Track",
        "category": "RUOSTE Spotify",
        "icon": "$(chevron-left)"
      },
      {
        "command": "ruoste.spotify.shuffle",
        "title": "Toggle Shuffle",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.repeat",
        "title": "Cycle Repeat",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.like",
        "title": "Save / Unsave Track",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.device",
        "title": "Transfer Playback\u2026",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.search",
        "title": "Search Spotify",
        "category": "RUOSTE Spotify",
        "icon": "$(search)"
      },
      {
        "command": "ruoste.spotify.dj",
        "title": "Spotify DJ",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.refresh",
        "title": "Refresh Spotify",
        "category": "RUOSTE Spotify",
        "icon": "$(refresh)"
      },
      {
        "command": "ruoste.spotify.playTrack",
        "title": "Play Track",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.playPlaylist",
        "title": "Play Playlist",
        "category": "RUOSTE Spotify",
        "icon": "$(play)"
      },
      {
        "command": "ruoste.spotify.queueTrack",
        "title": "Add to Queue",
        "category": "RUOSTE Spotify",
        "icon": "$(add)"
      },
      {
        "command": "ruoste.spotify.queueFromClipboard",
        "title": "Queue Spotify Link from Clipboard",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.addToPlaylist",
        "title": "Add to Playlist\u2026",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.transfer",
        "title": "Transfer Playback Here",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.spotify.openInSpotify",
        "title": "Open in Spotify",
        "category": "RUOSTE Spotify",
        "icon": "$(link-external)"
      },
      {
        "command": "ruoste.spotify.copyLink",
        "title": "Copy Spotify Link",
        "category": "RUOSTE Spotify"
      },
      {
        "command": "ruoste.actions.rediscover",
        "title": "Rediscover Repositories",
        "category": "RUOSTE",
        "icon": "$(sync)"
      },
      {
        "command": "ruoste.actions.pickScope",
        "title": "Choose Watched Repositories\u2026",
        "category": "RUOSTE",
        "icon": "$(filter)"
      },
      {
        "command": "ruoste.actions.filter",
        "title": "Go to Repository\u2026",
        "category": "RUOSTE",
        "icon": "$(search)"
      },
      {
        "command": "ruoste.actions.watchRepo",
        "title": "Watch Repository\u2026",
        "category": "RUOSTE"
      },
      {
        "command": "ruoste.actions.unwatchRepo",
        "title": "Stop Watching This Repository",
        "category": "RUOSTE"
      },
      {
        "command": "ruoste.diagnostics",
        "title": "Show Diagnostics",
        "category": "RUOSTE"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ruoste.actions.filter",
          "when": "view == ruoste.actions",
          "group": "navigation@1"
        },
        {
          "command": "ruoste.actions.refresh",
          "when": "view == ruoste.actions",
          "group": "navigation@2"
        },
        {
          "command": "ruoste.actions.pickScope",
          "when": "view == ruoste.actions",
          "group": "1_config@1"
        },
        {
          "command": "ruoste.actions.rediscover",
          "when": "view == ruoste.actions",
          "group": "1_config@2"
        },
        {
          "command": "ruoste.actions.watchRepo",
          "when": "view == ruoste.actions",
          "group": "1_config@3"
        },
        {
          "command": "ruoste.spotify.search",
          "when": "view == ruoste.spotify.library && ruoste.spotify.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "ruoste.spotify.refresh",
          "when": "view == ruoste.spotify.library",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "ruoste.actions.open",
          "when": "view == ruoste.actions && viewItem =~ /^ruoste\\.(run|job|repo)/",
          "group": "inline@1"
        },
        {
          "command": "ruoste.actions.rerun",
          "when": "view == ruoste.actions && viewItem == ruoste.run.done",
          "group": "inline@2"
        },
        {
          "command": "ruoste.actions.cancel",
          "when": "view == ruoste.actions && viewItem == ruoste.run.live",
          "group": "inline@2"
        },
        {
          "command": "ruoste.actions.copyUrl",
          "when": "view == ruoste.actions && viewItem =~ /^ruoste\\.(run|job)/",
          "group": "1_copy"
        },
        {
          "command": "ruoste.actions.unwatchRepo",
          "when": "view == ruoste.actions && viewItem =~ /^ruoste\\.repo/",
          "group": "1_copy"
        },
        {
          "command": "ruoste.actions.watchRepo",
          "when": "view == ruoste.actions && viewItem == ruoste.owner",
          "group": "1_copy"
        },
        {
          "command": "ruoste.spotify.queueTrack",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.track",
          "group": "inline@1"
        },
        {
          "command": "ruoste.spotify.playPlaylist",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.playlist",
          "group": "inline@1"
        },
        {
          "command": "ruoste.spotify.queueTrack",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.playlist",
          "group": "inline@2"
        },
        {
          "command": "ruoste.spotify.addToPlaylist",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.track",
          "group": "1_mod@1"
        },
        {
          "command": "ruoste.spotify.openInSpotify",
          "when": "view == ruoste.spotify.library && viewItem =~ /^ruoste\\.spotify\\.(track|playlist)/",
          "group": "2_open@1"
        },
        {
          "command": "ruoste.spotify.copyLink",
          "when": "view == ruoste.spotify.library && viewItem =~ /^ruoste\\.spotify\\.(track|playlist)/",
          "group": "2_open@2"
        },
        {
          "command": "ruoste.spotify.transfer",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.device",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ruoste.actions.open",
          "when": "false"
        },
        {
          "command": "ruoste.actions.copyUrl",
          "when": "false"
        },
        {
          "command": "ruoste.actions.rerun",
          "when": "false"
        },
        {
          "command": "ruoste.actions.cancel",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.playTrack",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.playPlaylist",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.queueTrack",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.addToPlaylist",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.transfer",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.openInSpotify",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.copyLink",
          "when": "false"
        },
        {
          "command": "ruoste.actions.watchRepo",
          "when": "true"
        },
        {
          "command": "ruoste.actions.unwatchRepo",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "RUOSTE",
      "properties": {
        "ruoste.actions.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Poll GitHub for new workflow runs automatically."
        },
        "ruoste.actions.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "markdownDescription": "Seconds between polls when nothing is running."
        },
        "ruoste.actions.liveRefreshInterval": {
          "type": "number",
          "default": 8,
          "minimum": 3,
          "markdownDescription": "Seconds between polls while a run is queued or in progress. Conditional requests make these near-free, so a short interval is affordable; jobs and steps refresh at this rate too."
        },
        "ruoste.actions.runCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "How many recent runs to list per repository.",
          "order": 7
        },
        "ruoste.actions.currentBranchOnly": {
          "type": "boolean",
          "default": false,
          "description": "Only show runs for the branch currently checked out."
        },
        "ruoste.actions.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the latest run's status in the status bar."
        },
        "ruoste.spotify.clientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Spotify **Client ID** from [developer.spotify.com/dashboard](https://developer.spotify.com/dashboard). Register `vscode://gapashu.ruoste/spotify` as a Redirect URI on that app. Run **RUOSTE Spotify: Set Spotify Client ID** for a guided setup.",
          "order": 10
        },
        "ruoste.spotify.pollInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 30,
          "markdownDescription": "Seconds between player polls while a track is playing.",
          "order": 11
        },
        "ruoste.spotify.idlePollInterval": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 120,
          "markdownDescription": "Seconds between polls while paused. Polling stops entirely when no RUOSTE view is visible.",
          "order": 12
        },
        "ruoste.spotify.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current track in the status bar.",
          "order": 13
        },
        "ruoste.spotify.statusBarMaxLength": {
          "type": "number",
          "default": 32,
          "minimum": 10,
          "maximum": 100,
          "description": "Truncate the status bar label to this many characters.",
          "order": 14
        },
        "ruoste.actions.scope": {
          "type": "string",
          "enum": [
            "affiliated",
            "workspace",
            "watchlist"
          ],
          "default": "affiliated",
          "enumDescriptions": [
            "Every repository you own, collaborate on, or can reach through an organisation.",
            "Only repositories open in this window.",
            "Only repositories matching ruoste.actions.repositories."
          ],
          "markdownDescription": "Which repositories the Actions view watches.",
          "order": 1
        },
        "ruoste.actions.repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra repositories to watch, as `owner/repo`. Wildcards allowed (`my-org/*`).",
          "order": 2
        },
        "ruoste.actions.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Repositories to hide, as `owner/repo`. Wildcards allowed (`old-org/*`).",
          "order": 3
        },
        "ruoste.actions.maxRepositories": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 300,
          "description": "Cap on how many repositories are watched at once.",
          "order": 4
        },
        "ruoste.actions.repositoriesPerCycle": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "How many idle repositories to refresh each cycle. Repositories you have expanded, or that have a run in progress, always refresh. Conditional requests mean unchanged repositories cost nothing against the rate limit.",
          "order": 5
        },
        "ruoste.actions.hideWithoutWorkflows": {
          "type": "boolean",
          "default": true,
          "description": "Hide repositories that have no workflow runs.",
          "order": 6
        },
        "ruoste.actions.notifications": {
          "type": "string",
          "enum": [
            "off",
            "failures",
            "completions",
            "all"
          ],
          "default": "failures",
          "enumDescriptions": [
            "Never notify.",
            "Only when a run finishes in anything other than success.",
            "Whenever a run finishes, pass or fail.",
            "Finishes and starts."
          ],
          "markdownDescription": "Notify when a workflow run changes state. Detected by polling \u2014 GitHub has no push channel a desktop client can subscribe to. More than three at once collapse into one summary.",
          "order": 8
        },
        "ruoste.actions.notifyOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Also notify when a run starts.",
          "order": 9
        }
      }
    }
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "python3 build/emit_themes.py && python3 build/emit_icons.py && node build/build_font.mjs 0",
    "check": "tsc -p jsconfig.json && node --test test/util.test.js test/spotify.test.js test/actions.test.js && python3 build/check_package.py",
    "verify": "node preview/audit.mjs && node preview/spot.mjs && node preview/icons_e2e.mjs",
    "preview": "node preview/render.mjs",
    "package": "vsce package --allow-missing-repository --no-dependencies",
    "all": "npm run build && npm run check && npm run package",
    "ui": "node preview/spotify_ui.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "geist": "^1.3.1",
    "playwright": "^1.47.0",
    "shiki": "^1.22.0",
    "svg2ttf": "^6.0.3",
    "svgicons2svgfont": "^15.0.0",
    "ttf2woff2": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnBrandt00/ruoste.git"
  }
}