    "menus": {
      "view/title": [
        {
          "command": "ruoste.actions.openDashboard",
          "when": "view == ruoste.actions",
          "group": "navigation@0"
        },
        {
          "command": "ruoste.actions.runWorkflow",
          "when": "view == ruoste.actions",
          "group": "navigation@1"
        },
        {
          "command": "ruoste.actions.filter",
          "when": "view == ruoste.actions",
          "group": "navigation@1"
        },
        {
          "command": "ruoste.actions.refresh",
          "when": "view == ruoste.actions",
          "group": "navigation@2"
        },
        {
          "command": "ruoste.actions.pickScope",
          "when": "view == ruoste.actions",
          "group": "1_config@1"
        },
        {
          "command": "ruoste.actions.rediscover",
          "when": "view == ruoste.actions",
          "group": "1_config@2"
        },
        {
          "command": "ruoste.actions.watchRepo",
          "when": "view == ruoste.actions",
          "group": "1_config@3"
        },
        {
          "command": "ruoste.spotify.search",
          "when": "view == ruoste.spotify.library && ruoste.spotify.signedIn",
          "group": "navigation@1"
        },
        {
          "command": "ruoste.spotify.refresh",
          "when": "view == ruoste.spotify.library",
          "group": "navigation@2"
        },
        {
          "command": "ruoste.spotify.openPanel",
          "when": "view == ruoste.spotify.nowPlaying",
          "group": "navigation@1"
        },
        {
          "command": "ruoste.work.newIssue",
          "when": "view == ruoste.work",
          "group": "navigation@0"
        },
        {
          "command": "ruoste.work.search",
          "when": "view == ruoste.work",
          "group": "navigation@1"
        },
        {
          "command": "ruoste.work.refresh",
          "when": "view == ruoste.work",
          "group": "navigation@2"
        },
        {
          "command": "ruoste.work.pickSections",
          "when": "view == ruoste.work",
          "group": "1_config@1"
        }
      ],
      "view/item/context": [
        {
          "command": "ruoste.actions.open",
          "when": "view == ruoste.actions && viewItem =~ /^ruoste\\.(run|job|repo)/",
          "group": "inline@1"
        },
        {
          "command": "ruoste.actions.rerun",
          "when": "view == ruoste.actions && viewItem == ruoste.run.done",
          "group": "inline@2"
        },
        {
          "command": "ruoste.actions.cancel",
          "when": "view == ruoste.actions && viewItem == ruoste.run.live",
          "group": "inline@2"
        },
        {
          "command": "ruoste.actions.copyUrl",
          "when": "view == ruoste.actions && viewItem =~ /^ruoste\\.(run|job)/",
          "group": "1_copy"
        },
        {
          "command": "ruoste.actions.unwatchRepo",
          "when": "view == ruoste.actions && viewItem =~ /^ruoste\\.repo/",
          "group": "1_copy"
        },
        {
          "command": "ruoste.actions.watchRepo",
          "when": "view == ruoste.actions && viewItem == ruoste.owner",
          "group": "1_copy"
        },
        {
          "command": "ruoste.spotify.queueTrack",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.track",
          "group": "inline@1"
        },
        {
          "command": "ruoste.spotify.playPlaylist",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.playlist",
          "group": "inline@1"
        },
        {
          "command": "ruoste.spotify.queueTrack",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.playlist",
          "group": "inline@2"
        },
        {
          "command": "ruoste.spotify.addToPlaylist",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.track",
          "group": "1_mod@1"
        },
        {
          "command": "ruoste.spotify.openInSpotify",
          "when": "view == ruoste.spotify.library && viewItem =~ /^ruoste\\.spotify\\.(track|playlist)/",
          "group": "2_open@1"
        },
        {
          "command": "ruoste.spotify.copyLink",
          "when": "view == ruoste.spotify.library && viewItem =~ /^ruoste\\.spotify\\.(track|playlist)/",
          "group": "2_open@2"
        },
        {
          "command": "ruoste.spotify.transfer",
          "when": "view == ruoste.spotify.library && viewItem == ruoste.spotify.device",
          "group": "inline@1"
        },
        {
          "command": "ruoste.actions.rerunFailed",
          "when": "view == ruoste.actions && viewItem == ruoste.run.done",
          "group": "1_copy@0"
        },
        {
          "command": "ruoste.actions.runWorkflow",
          "when": "view == ruoste.actions && viewItem =~ /^ruoste\\.repo/",
          "group": "1_copy@1"
        },
        {
          "command": "ruoste.work.comment",
          "when": "view == ruoste.work && viewItem =~ /^ruoste\\.work\\.item/",
          "group": "inline@1"
        },
        {
          "command": "ruoste.work.open",
          "when": "view == ruoste.work && viewItem =~ /^ruoste\\.work\\.item/",
          "group": "inline@2"
        },
        {
          "command": "ruoste.work.assign",
          "when": "view == ruoste.work && viewItem =~ /^ruoste\\.work\\.item/",
          "group": "1_edit@1"
        },
        {
          "command": "ruoste.work.label",
          "when": "view == ruoste.work && viewItem =~ /^ruoste\\.work\\.item/",
          "group": "1_edit@2"
        },
        {
          "command": "ruoste.work.requestReview",
          "when": "view == ruoste.work && viewItem == ruoste.work.item.pr",
          "group": "1_edit@3"
        },
        {
          "command": "ruoste.work.checkout",
          "when": "view == ruoste.work && viewItem == ruoste.work.item.pr",
          "group": "2_pr@1"
        },
        {
          "command": "ruoste.work.merge",
          "when": "view == ruoste.work && viewItem == ruoste.work.item.pr",
          "group": "2_pr@2"
        },
        {
          "command": "ruoste.work.close",
          "when": "view == ruoste.work && viewItem =~ /^ruoste\\.work\\.item\\.(pr|issue)$/",
          "group": "3_state@1"
        },
        {
          "command": "ruoste.work.reopen",
          "when": "view == ruoste.work && viewItem =~ /^ruoste\\.work\\.item\\..*closed$/",
          "group": "3_state@1"
        },
        {
          "command": "ruoste.work.copyUrl",
          "when": "view == ruoste.work && viewItem =~ /^ruoste\\.work\\.item/",
          "group": "4_copy@1"
        },
        {
          "command": "ruoste.work.newIssue",
          "when": "view == ruoste.work && viewItem == ruoste.work.repo",
          "group": "1_edit@1"
        }
      ],
      "commandPalette": [
        {
          "command": "ruoste.actions.open",
          "when": "false"
        },
        {
          "command": "ruoste.actions.copyUrl",
          "when": "false"
        },
        {
          "command": "ruoste.actions.rerun",
          "when": "false"
        },
        {
          "command": "ruoste.actions.cancel",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.playTrack",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.playPlaylist",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.queueTrack",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.addToPlaylist",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.transfer",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.openInSpotify",
          "when": "false"
        },
        {
          "command": "ruoste.spotify.copyLink",
          "when": "false"
        },
        {
          "command": "ruoste.actions.watchRepo",
          "when": "true"
        },
        {
          "command": "ruoste.actions.unwatchRepo",
          "when": "false"
        },
        {
          "command": "ruoste.actions.rerunFailed",
          "when": "false"
        },
        {
          "command": "ruoste.work.view",
          "when": "false"
        },
        {
          "command": "ruoste.work.open",
          "when": "false"
        },
        {
          "command": "ruoste.work.copyUrl",
          "when": "false"
        },
        {
          "command": "ruoste.work.comment",
          "when": "false"
        },
        {
          "command": "ruoste.work.close",
          "when": "false"
        },
        {
          "command": "ruoste.work.reopen",
          "when": "false"
        },
        {
          "command": "ruoste.work.assign",
          "when": "false"
        },
        {
          "command": "ruoste.work.label",
          "when": "false"
        },
        {
          "command": "ruoste.work.requestReview",
          "when": "false"
        },
        {
          "command": "ruoste.work.merge",
          "when": "false"
        },
        {
          "command": "ruoste.work.checkout",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "RUOSTE",
      "properties": {
        "ruoste.actions.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Poll GitHub for new workflow runs automatically."
        },
        "ruoste.actions.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "markdownDescription": "Seconds between polls when nothing is running."
        },
        "ruoste.actions.liveRefreshInterval": {
          "type": "number",
          "default": 8,
          "minimum": 3,
          "markdownDescription": "Seconds between polls while a run is queued or in progress. Conditional requests make these near-free, so a short interval is affordable; jobs and steps refresh at this rate too."
        },
        "ruoste.actions.runCount": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "maximum": 100,
          "description": "How many recent runs to list per repository.",
          "order": 7
        },
        "ruoste.actions.currentBranchOnly": {
          "type": "boolean",
          "default": false,
          "description": "Only show runs for the branch currently checked out."
        },
        "ruoste.actions.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the latest run's status in the status bar."
        },
        "ruoste.spotify.clientId": {
          "type": "string",
          "default": "",
          "markdownDescription": "Spotify **Client ID** from [developer.spotify.com/dashboard](https://developer.spotify.com/dashboard). Register `vscode://gapashu.ruoste/spotify` as a Redirect URI on that app. Run **RUOSTE Spotify: Set Spotify Client ID** for a guided setup.",
          "order": 10
        },
        "ruoste.spotify.pollInterval": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 30,
          "markdownDescription": "Seconds between player polls while a track is playing.",
          "order": 11
        },
        "ruoste.spotify.idlePollInterval": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 120,
          "markdownDescription": "Seconds between polls while paused. Polling stops entirely when no RUOSTE view is visible.",
          "order": 12
        },
        "ruoste.spotify.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the current track in the status bar.",
          "order": 13
        },
        "ruoste.spotify.statusBarMaxLength": {
          "type": "number",
          "default": 32,
          "minimum": 10,
          "maximum": 100,
          "description": "Truncate the status bar label to this many characters.",
          "order": 14
        },
        "ruoste.actions.scope": {
          "type": "string",
          "enum": [
            "affiliated",
            "workspace",
            "watchlist"
          ],
          "default": "affiliated",
          "enumDescriptions": [
            "Every repository you own, collaborate on, or can reach through an organisation.",
            "Only repositories open in this window.",
            "Only repositories matching ruoste.actions.repositories."
          ],
          "markdownDescription": "Which repositories the Actions view watches.",
          "order": 1
        },
        "ruoste.actions.repositories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra repositories to watch, as `owner/repo`. Wildcards allowed (`my-org/*`).",
          "order": 2
        },
        "ruoste.actions.exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Repositories to hide, as `owner/repo`. Wildcards allowed (`old-org/*`).",
          "order": 3
        },
        "ruoste.actions.maxRepositories": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "maximum": 300,
          "description": "Cap on how many repositories are watched at once.",
          "order": 4
        },
        "ruoste.actions.repositoriesPerCycle": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "How many idle repositories to refresh each cycle. Repositories you have expanded, or that have a run in progress, always refresh. Conditional requests mean unchanged repositories cost nothing against the rate limit.",
          "order": 5
        },
        "ruoste.actions.hideWithoutWorkflows": {
          "type": "boolean",
          "default": true,
          "description": "Hide repositories that have no workflow runs.",
          "order": 6
        },
        "ruoste.actions.notifications": {
          "type": "string",
          "enum": [
            "off",
            "failures",
            "completions",
            "all"
          ],
          "default": "failures",
          "enumDescriptions": [
            "Never notify.",
            "Only when a run finishes in anything other than success.",
            "Whenever a run finishes, pass or fail.",
            "Finishes and starts."
          ],
          "markdownDescription": "Notify when a workflow run changes state. Detected by polling \u2014 GitHub has no push channel a desktop client can subscribe to. More than three at once collapse into one summary.",
          "order": 8
        },
        "ruoste.actions.notifyOnStart": {
          "type": "boolean",
          "default": false,
          "description": "Also notify when a run starts.",
          "order": 9
        },
        "ruoste.spotify.queueBatchLimit": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "maximum": 200,
          "markdownDescription": "Most tracks to add when queueing a whole album or playlist. Spotify's queue endpoint takes one track per request, so this is one request each.",
          "order": 15
        },
        "ruoste.actions.groupByOwner": {
          "type": "boolean",
          "default": true,
          "description": "Group repositories under their owner. Off gives one flat list.",
          "order": 10
        },
        "ruoste.actions.dashboardRunsPerRepo": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 20,
          "description": "Runs shown per repository in the pipelines dashboard.",
          "order": 11
        },
        "ruoste.actions.confirmDispatch": {
          "type": "boolean",
          "default": true,
          "description": "Ask before dispatching a workflow run.",
          "order": 12
        },
        "ruoste.spotify.queueLength": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 50,
          "description": "How many upcoming tracks to list in Now Playing.",
          "order": 16
        },
        "ruoste.spotify.queuePollInterval": {
          "type": "number",
          "default": 8,
          "minimum": 3,
          "maximum": 60,
          "markdownDescription": "Seconds between queue reads. The queue is also refetched immediately after anything that reorders it \u2014 queueing, skipping, shuffling \u2014 since Spotify's queue endpoint lags writes.",
          "order": 17
        },
        "ruoste.spotify.showArtwork": {
          "type": "boolean",
          "default": true,
          "description": "Show album artwork and its blurred backdrop.",
          "order": 18
        },
        "ruoste.actions.dashboardLayout": {
          "type": "string",
          "enum": [
            "grid",
            "list",
            "split"
          ],
          "default": "grid",
          "enumDescriptions": [
            "Cards in an auto-fitting grid.",
            "Dense rows \u2014 best when the panel is narrow.",
            "Repositories on the left, the selected one's runs on the right."
          ],
          "description": "Layout of the pipelines dashboard.",
          "order": 13
        },
        "ruoste.actions.dashboardCompact": {
          "type": "boolean",
          "default": false,
          "description": "Tighter rows and smaller type in the pipelines dashboard.",
          "order": 14
        },
        "ruoste.layout.playerShare": {
          "type": "number",
          "default": 0.4,
          "minimum": 0.15,
          "maximum": 0.8,
          "markdownDescription": "Share of the utilities column given to the player when running **Open Utilities Layout**.",
          "order": 30
        },
        "ruoste.work.sections": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "review",
              "assigned",
              "created",
              "mentioned",
              "workspace"
            ],
            "enumDescriptions": [
              "Pull requests waiting on your review.",
              "Issues and pull requests assigned to you.",
              "Issues and pull requests you opened.",
              "Anything that mentions you.",
              "Open issues and pull requests in the repositories open in this window."
            ]
          },
          "default": [
            "review",
            "assigned",
            "created",
            "workspace"
          ],
          "markdownDescription": "Sections shown in the Issues & PRs view, in this order. Each search-backed section costs one request per refresh.",
          "order": 40
        },
        "ruoste.work.include": {
          "type": "string",
          "enum": [
            "both",
            "issues",
            "prs"
          ],
          "enumDescriptions": [
            "Issues and pull requests.",
            "Issues only.",
            "Pull requests only."
          ],
          "default": "both",
          "description": "What the Issues & PRs view lists.",
          "order": 41
        },
        "ruoste.work.itemLimit": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 100,
          "description": "How many items to list per section.",
          "order": 42
        },
        "ruoste.work.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Poll GitHub for new issues and pull requests automatically.",
          "order": 43
        },
        "ruoste.work.refreshInterval": {
          "type": "number",
          "default": 180,
          "minimum": 30,
          "markdownDescription": "Seconds between polls. Search has its own rate limit (30 requests a minute), which a handful of queries every few minutes never approaches.",
          "order": 44
        },
        "ruoste.work.notifications": {
          "type": "string",
          "enum": [
            "off",
            "review-requested",
            "assigned",
            "all"
          ],
          "enumDescriptions": [
            "Never notify.",
            "Only when a pull request is sent to you for review.",
            "Review requests and issues assigned to you.",
            "Anything new in any section."
          ],
          "default": "review-requested",
          "markdownDescription": "Notify when something new appears. Detected by diffing polls \u2014 the first pass after start-up is silent, so signing in does not announce your whole backlog.",
          "order": 45
        },
        "ruoste.work.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show review requests and assigned items in the status bar.",
          "order": 46
        },
        "ruoste.work.mergeMethod": {
          "type": "string",
          "enum": [
            "merge",
            "squash",
            "rebase"
          ],
          "default": "merge",
          "description": "Merge method offered first when merging a pull request.",
          "order": 47
        },
        "ruoste.work.confirmMerge": {
          "type": "boolean",
          "default": true,
          "description": "Ask before merging a pull request.",
          "order": 48
        }
      }
    }
  },
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "build": "python3 build/emit_themes.py && python3 build/emit_icons.py && python3 build/emit_producticons.py && node build/build_font.mjs 0",
    "check": "tsc -p jsconfig.json && node --test test/util.test.js test/spotify.test.js test/actions.test.js test/work.test.js && python3 build/check_package.py",
    "verify": "node preview/audit.mjs && node preview/spot.mjs && node preview/icons_e2e.mjs",
    "preview": "node preview/render.mjs",
    "package": "vsce package --allow-missing-repository --no-dependencies",
    "all": "npm run build && npm run check && npm run package",
    "ui": "node preview/spotify_ui.mjs && node preview/pipelines_ui.mjs && node preview/work_ui.mjs"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "geist": "^1.3.1",
    "playwright": "^1.47.0",
    "shiki": "^1.22.0",
    "svg2ttf": "^6.0.3",
    "svgicons2svgfont": "^15.0.0",
    "ttf2woff2": "^8.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnBrandt00/ruoste.git"
  }
}